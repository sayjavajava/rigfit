# Maintainer: rigfit contributors
# This file is a template: .github/workflows/aur.yml substitutes @VERSION@
# and @SHA256@ at release time and pushes the rendered PKGBUILD to AUR. It
# is not itself a valid PKGBUILD.
pkgname=rigfit-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="Correct, local-first game compatibility checker"
arch=('x86_64')
url="https://github.com/sayjavajava/rigfit"
license=('GPL-3.0-only')
provides=('rigfit')
conflicts=('rigfit')
source=("https://github.com/sayjavajava/rigfit/releases/download/v${pkgver}/rigfit_${pkgver}_linux_amd64.tar.gz")
sha256sums=('@SHA256@')

package() {
    install -Dm755 "${srcdir}/rigfit" "${pkgdir}/usr/bin/rigfit"
    install -Dm644 "${srcdir}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
